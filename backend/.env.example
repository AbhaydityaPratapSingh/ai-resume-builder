NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional: point Puppeteer at a specific Chrome binary instead of its bundled
# download, plus any extra shared-library path that binary needs.
PUPPETEER_EXECUTABLE_PATH=
LD_LIBRARY_PATH=

# Optional AI layer — leave AI_ENABLED=false.
# The app is fully functional with AI off: nothing under src/llm/ is loaded,
# and the provider SDK is never touched.
AI_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_DAILY_SPEND_CAP_INR=
